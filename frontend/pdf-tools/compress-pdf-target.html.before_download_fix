<script>
const API_ENDPOINT="http://127.0.0.1:8000/api/v1/pdf/compress";
const MAX=100*1024*1024;
let selectedFile=null,targetKB=null,selectedProfile="recommended";
const $=id=>document.getElementById(id);
const input=$("input"),drop=$("drop"),preview=$("preview"),compress=$("compress"),error=$("error"),progress=$("progress"),result=$("result");
const ACCESS_TOKEN_KEY = "pdf_master_access_token";

function getAccessToken(){
    return (
        localStorage.getItem(ACCESS_TOKEN_KEY) ||
        sessionStorage.getItem(ACCESS_TOKEN_KEY)
    );
}

function logout(){
    localStorage.removeItem(ACCESS_TOKEN_KEY);
    sessionStorage.removeItem(ACCESS_TOKEN_KEY);
    window.location.href="../login.html";
}

const accessToken = getAccessToken();

if(!accessToken){
    window.location.replace("../login.html");
}

if($("logoutTop")){
    $("logoutTop").addEventListener("click",logout);
}

if($("logoutMobile")){
    $("logoutMobile").addEventListener("click",logout);
}


$("menu").onclick=()=>{$("mobile").style.display=$("mobile").style.display==="block"?"none":"block"};
$("select").addEventListener("click",function(event){
    event.preventDefault();
    input.click();
});

input.addEventListener("change",function(){
    const file=input.files && input.files[0];
    if(file){
        handleFile(file);
    }
    input.value="";
});
document.querySelectorAll(".profile").forEach(button=>{
    button.addEventListener("click",()=>{
        selectProfile(button.dataset.profile);
        updateProfileTargets();
    });
});

$("apply").addEventListener("click",()=>{
    const value=Number($("target").value);
    const unit=$("unit").value;
    if(!Number.isFinite(value) || value<100){
        showError("Target minimal 100 KB.");
        return;
    }
    targetKB=unit==="MB" ? value*1024 : value;
    selectedProfile="custom";
    document.querySelectorAll(".profile").forEach(b=>b.classList.remove("active"));
    clearError();
    updateButton();
});

function selectProfile(profile){
    selectedProfile=profile;
    document.querySelectorAll(".profile").forEach(b=>{
        b.classList.toggle("active",b.dataset.profile===profile);
    });
    if(selectedFile){
        targetKB=profileTarget(selectedFile.size,profile);
        $("target").value=Math.round(targetKB);
        $("unit").value="KB";
    }
}

function profileTarget(size,profile){
    const mb=size/(1024*1024);

    if(profile==="extreme"){
        if(mb<1) return Math.max(100,Math.min(200,Math.floor(size/1024*0.45)));
        if(mb<5) return 250;
        return 300;
    }

    if(profile==="less"){
        if(mb<1) return Math.max(300,Math.floor(size/1024*0.80));
        if(mb<5) return 1000;
        if(mb<10) return 1500;
        return 2000;
    }

    if(mb<1) return Math.max(250,Math.floor(size/1024*0.60));
    if(mb<2) return 400;
    return 500;
}

function updateProfileTargets(){
    if(!selectedFile) return;
    $("extremeTarget").textContent=formatTarget(profileTarget(selectedFile.size,"extreme"));
    $("recommendedTarget").textContent=formatTarget(profileTarget(selectedFile.size,"recommended"));
    $("lessTarget").textContent=formatTarget(profileTarget(selectedFile.size,"less"));
    if(selectedProfile!=="custom"){
        targetKB=profileTarget(selectedFile.size,selectedProfile);
        $("target").value=Math.round(targetKB);
        $("unit").value="KB";
    }
}

function profileLabel(profile){
    return profile==="extreme"?"Extreme":profile==="less"?"Less":profile==="custom"?"Custom":"Recommended";
}

function formatTarget(kb){
    return kb>=1024 ? (kb/1024).toFixed(kb%1024?1:0)+" MB" : Math.round(kb)+" KB";
}

["dragenter","dragover"].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add("drag")}));
["dragleave","drop"].forEach(n=>drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove("drag")}));
drop.ondrop=e=>{const f=[...e.dataTransfer.files][0];if(f)handleFile(f)};

function handleFile(file){
 clearError();result.classList.remove("show");
 if(!(file.type==="application/pdf"||file.name.toLowerCase().endsWith(".pdf"))){showError("File yang dipilih bukan PDF.");resetFile();return}
 if(file.size>MAX){showError("Ukuran file terlalu besar. Maksimal 100 MB.");resetFile();return}
 selectedFile=file;$("fileName").textContent=file.name;$("fileSize").textContent=bytes(file.size);preview.classList.add("show");
 selectProfile("recommended"); updateProfileTargets(); updateButton();
}
$("remove").onclick=resetFile;





compress.onclick=async()=>{
    if(!selectedFile){
        showError("Silakan pilih file PDF terlebih dahulu.");
        return;
    }

    if(!targetKB || targetKB<50){
        showError("Silakan pilih target ukuran PDF.");
        return;
    }

    clearError();
    result.classList.remove("show");
    progress.classList.add("show");
    compress.disabled=true;

    const token = getAccessToken();

if(!token){
    progress.classList.remove("show");
    showError("Sesi login tidak ditemukan. Silakan login terlebih dahulu.");
    compress.disabled=false;
    return;
}

    try{

        // ==================================================
        // STEP 1 — UPLOAD PDF
        // ==================================================

        setProgress(
            10,
            "Mengunggah PDF ke server..."
        );

        const uploadForm = new FormData();

        uploadForm.append(
            "file",
            selectedFile
        );

        const uploadResponse = await fetch(
            "http://127.0.0.1:8000/api/v1/storage/upload",
            {
                method:"POST",
                headers:{
                    "Authorization":"Bearer "+token
                },
                body:uploadForm
            }
        );

        if(!uploadResponse.ok){

            let message =
                "Gagal mengunggah PDF.";

            try{
                const data =
                    await uploadResponse.json();

                message =
                    data.detail ||
                    data.message ||
                    message;

            }catch(_){}

            throw new Error(
                message
            );
        }

        const uploadData =
            await uploadResponse.json();

        console.log(
            "UPLOAD RESPONSE:",
            uploadData
        );

        const fileId =
            uploadData.file_id ||
            uploadData.id ||
            uploadData.file?.id;

        if(!fileId){

            throw new Error(
                "File berhasil diunggah, tetapi file_id tidak ditemukan dari server."
            );
        }

        // ==================================================
        // STEP 2 — COMPRESS
        // ==================================================

        setProgress(
            40,
            "Menganalisis PDF..."
        );

        const compressUrl =
            "http://127.0.0.1:8000/api/v1/pdf/compress" +
            "?file_id=" +
            encodeURIComponent(fileId) +
            "&target_size_kb=" +
            encodeURIComponent(Math.round(targetKB)) +
            "&profile=" +
            encodeURIComponent(selectedProfile);

        setProgress(
            60,
            "Mengompres PDF dengan mode " + profileLabel(selectedProfile) + "..."
        );

        const response =
            await fetch(
                compressUrl,
                {
                    method:"POST",
                    headers:{
                        "Authorization":
                            "Bearer "+token,
                        "Accept":
                            "application/json"
                    }
                }
            );

        if(!response.ok){

            let message =
                "Gagal memperkecil ukuran PDF.";

            try{

                const data =
                    await response.json();

                message =
                    data.detail ||
                    data.message ||
                    message;

            }catch(_){}

            throw new Error(
                message
            );
        }

        const data =
            await response.json();

        console.log(
            "COMPRESS RESPONSE:",
            data
        );

        // ==================================================
        // STEP 3 — HASIL
        // ==================================================

        const compression =
            data.compression || {};

        const beforeSize =
            Number(
                compression.before_size ||
                selectedFile.size
            );

        const afterSize =
            Number(
                compression.after_size ||
                0
            );

        const savedBytes =
            Number(
                compression.saved_bytes ||
                0
            );

        if(!data.file){
            throw new Error(
                "Server tidak mengembalikan informasi file hasil."
            );
        }

        setProgress(
            100,
            "PDF berhasil dikompres."
        );

        const saving =
            beforeSize > 0
            ? Math.max(
                0,
                savedBytes / beforeSize * 100
            )
            : 0;

        $("before").textContent =
            bytes(beforeSize);

        $("after").textContent =
            bytes(afterSize);

        $("saving").textContent =
            saving.toFixed(1) + "%";

// ==================================================
// DOWNLOAD HASIL PDF
// ==================================================

const downloadUrl =
    "http://127.0.0.1:8000/api/v1/pdf/download-compressed" +
    "?file_id=" +
    encodeURIComponent(fileId) +
    "&target_size_kb=" +
    encodeURIComponent(Math.round(targetKB)) +
    "&profile=" +
    encodeURIComponent(selectedProfile);

$("download").onclick = async function(event) {

    event.preventDefault();

    try {

        const token = getAccessToken();

        if (!token) {

            showError(
                "Sesi login tidak ditemukan. Silakan login kembali."
            );

            return;
        }

        $("download").textContent =
            "Menyiapkan download...";

        $("download").style.pointerEvents =
            "none";

        const downloadResponse =
            await fetch(
                downloadUrl,
                {
                    method: "GET",

                    headers: {
                        "Authorization":
                            "Bearer " + token
                    }
                }
            );

        if (!downloadResponse.ok) {

            let message =
                "Gagal mengunduh PDF.";

            try {

                const responseData =
                    await downloadResponse.json();

                message =
                    responseData.detail ||
                    responseData.message ||
                    message;

            } catch (_) {}

            throw new Error(message);
        }

        const blob =
            await downloadResponse.blob();

        const blobUrl =
            window.URL.createObjectURL(blob);

        const link =
            document.createElement("a");

        link.href =
            blobUrl;

        link.download =
            (data.file && data.file.output_name) ||
            selectedFile.name.replace(
                /\.pdf$/i,
                ""
            ) + "-compressed.pdf";

        document.body.appendChild(link);

        link.click();

        link.remove();

        window.URL.revokeObjectURL(
            blobUrl
        );

    } catch (error) {

        console.error(
            "DOWNLOAD ERROR:",
            error
        );

        showError(
            error.message ||
            "Gagal mengunduh PDF hasil kompresi."
        );

    } finally {

        $("download").textContent =
            "Download PDF";

        $("download").style.pointerEvents =
            "auto";
    }
};



        result.classList.add(
            "show"
        );

    }catch(e){

        progress.classList.remove(
            "show"
        );

        showError(
            e.message ||
            "Terjadi kesalahan saat mengompres PDF."
        );

    }finally{

        updateButton();

    }
};

$("again").onclick=()=>{resetFile();window.scrollTo({top:0,behavior:"smooth"})};

function updateButton(){compress.disabled=!selectedFile||!targetKB}
function resetFile(){selectedFile=null;input.value="";targetKB=null;selectedProfile="recommended";document.querySelectorAll(".profile").forEach(b=>b.classList.toggle("active",b.dataset.profile==="recommended"));preview.classList.remove("show");compress.disabled=true;progress.classList.remove("show");result.classList.remove("show");clearError()}
function setProgress(p,m){$("bar").style.width=p+"%";$("percent").textContent=p+"%";$("message").textContent=m}
function showError(m){error.textContent=m;error.classList.add("show")}
function clearError(){error.textContent="";error.classList.remove("show")}
function bytes(s){if(!s)return"0 B";const u=["B","KB","MB","GB"],i=Math.min(Math.floor(Math.log(s)/Math.log(1024)),3);return(s/Math.pow(1024,i)).toFixed(i?2:0)+" "+u[i]}
</script>
</body>
